# 复制为 .env.local 后填写
OPENAI_API_KEY=
# 兼容 OpenAI 协议的任意地址，默认 OpenAI 官方
OPENAI_BASE_URL=https://api.openai.com/v1
# 填你账号里 GPT-6.1 Sol 的准确 model id
OPENAI_MODEL=
# 不填 Key 时自动进入「演示回放模式」（脚本化回放，仅用于开发自测 / 断网兜底）
TAVILY_API_KEY=   # 可选：配置后 Agent 可联网搜索市场信息

# 识别 Agent：JD 图片识别（多模态模型；默认复用上面的地址和 Key，也可用 VISION_BASE_URL / VISION_API_KEY 单独配置）
VISION_MODEL=glm-5.3-flash
VISION_FALLBACK_MODEL=gpt-5.4-mini

# 联网搜索（市场 Agent）：zhipu（智谱 Web Search，默认）或 tavily
SEARCH_PROVIDER=zhipu
SEARCH_API_KEY=
SEARCH_ENGINE=search_pro_quark

# 撰写 Agent / 审查 Agent：一次性产出 JSON 的子任务用更快的模型（实测比主模型快 3 倍）
FAST_MODEL=glm-5.3-flash
